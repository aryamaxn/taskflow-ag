# Environment Configuration for TaskFlow

# Port to run the server on (default: 3000)
PORT=3000

# Base URL of the application (used to construct OAuth callback URL)
# For local development: http://localhost:3000
# For production (e.g. Render, Railway, Vercel): https://your-taskflow-domain.com
BASE_URL=http://localhost:3000

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/taskflow?retryWrites=true&w=majority

# Express Session Secret (any secure random string)
SESSION_SECRET=your_super_secret_session_key_here_generate_random

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here

# Node environment: 'development' or 'production'
NODE_ENV=development
